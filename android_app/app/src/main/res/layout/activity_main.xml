<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:alpha="0.9"
        android:background="@drawable/bg_glow" />

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/green"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:fontFamily="monospace"
                android:letterSpacing="0.16"
                android:paddingStart="13dp"
                android:paddingTop="6dp"
                android:paddingEnd="13dp"
                android:paddingBottom="6dp"
                android:text="@string/eyebrow"
                android:textColor="@color/green_soft"
                android:textSize="8sp" />

            <ImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_logo"
                android:contentDescription="@string/app_name"
                android:elevation="6dp"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.06"
                android:text="LACAK DETEKTOR AIR"
                android:textColor="@color/green_bright"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:text="@string/subtitle"
                android:textColor="@color/dim"
                android:textSize="8sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:alpha="0.82"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/intro"
                android:textColor="@color/green_bright"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="@string/connection_title"
                        android:textColor="@color/green"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="01"
                        android:textColor="@color/dim"
                        android:textSize="8sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/connection_sub"
                    android:textColor="@color/dim"
                    android:textSize="10sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#1E4A32" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.13"
                    android:text="@string/address_label"
                    android:textColor="@color/dim"
                    android:textSize="8sp" />

                <EditText
                    android:id="@+id/ip_input"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="monospace"
                    android:hint="@string/ip_hint"
                    android:imeOptions="actionGo"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:selectAllOnFocus="true"
                    android:singleLine="true"
                    android:textColor="@color/green_bright"
                    android:textColorHint="@color/dim"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/open"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/open_radar" />

                <Button
                    android:id="@+id/wifi"
                    style="@style/GhostButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/wifi_settings" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/status_idle"
                    android:textColor="@color/dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:text="@string/help_title"
                    android:textColor="@color/green_soft"
                    android:textSize="8sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:alpha="0.82"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/help_steps"
                    android:textColor="@color/green_bright"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/back_hint"
                android:textColor="@color/dim"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:alpha="0.6"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:text="@string/version"
                android:textColor="@color/dim"
                android:textSize="8sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
